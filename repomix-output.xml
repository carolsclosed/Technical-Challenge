    <>
      <div className="section-heading">
        <h1>{t("merchants")}</h1>
        <ModalForm
          title="newMerchant"
          operation="merchant"
          values={{ name: "", slug: "" }}
          fields={[
            { name: "name", required: true },
            { name: "slug", required: true },
          ]}
