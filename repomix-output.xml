    ])).rowCount,
    1,
  );
  assert.equal(
    (await c.query("update public.stores set name='Staff store edit' where id=$1", [store]))
      .rowCount,
    0,
  );
  await asUser(c, "admin");
  const invitation = await createInvitation(
    c,
    merchant1,
    "delivery-test@mesa.test",
    "staff",
    [store],
  );
  assert.equal(
