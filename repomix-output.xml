              name: "",
              street: "",
              city: "",
              state: "",
              zip_code: "",
              phone: "",
              timezone: "Europe/Lisbon",
              active: true,
            }}
            fields={storeFields}
          />
        )}
      </div>
      <div className="grid">
        {stores.map((s) => (
          <div className="card card-body" key={s.id}>
            <div className="row">
              <h3>{s.name}</h3>
              <span className="badge">
                {t(s.active ? "active" : "inactive")}
              </span>
            </div>
            <p>
              {s.street}
              <br />
              {s.city} · {s.timezone}
            </p>
            <div className="actions">
