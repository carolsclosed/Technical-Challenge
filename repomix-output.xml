                <Button asChild size="sm">
                  <Link href={`/${slug}/dashboard/stores/${s.id}`}>
                    {t("products")}
                  </Link>
                </Button>
              )}
              {canManage && (
                <>
                  <ModalForm
                    title="edit"
                    operation="store"
                    values={{ ...s, merchant }}
