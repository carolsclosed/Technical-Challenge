import { accountCartKey, guestCartKey } from "@/lib/cart-session";

const mocks = vi.hoisted(() => ({
  getUser: vi.fn(),
  getSession: vi.fn(),
  subscribe: vi.fn(),
  navigate: vi.fn(),
}));
vi.mock("@/lib/supabase/client", () => ({
  browserClient: () => ({
