{
  "name": "mesa-marketplace",
  "version": "1.0.0",
  "description": "Multi-merchant food-ordering marketplace",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "tsx scripts/test-db.ts",
    "db:start": "node scripts/start-supabase.mjs",
    "db:setup": "npm run db:start && node scripts/write-local-env.mjs && npm run db:initialize && npm run seed:users",
    "db:initialize": "tsx scripts/initialize-local-db.ts",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "email:verify": "node --conditions=react-server --import tsx scripts/verify-smtp.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "libphonenumber-js": "1.13.12",
    "lucide-react": "1.43.0",
    "next": "16.3.4",
    "next-intl": "4.14.2",
    "next-themes": "0.4.6",
    "nodemailer": "10.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "server-only": "0.0.1",
    "standardwebhooks": "1.1.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.5.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "jsdom": "30.0.1",
    "pg": "8.23.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  },
  "private": true,
  "engines": {
    "node": ">=22 <25"
  }
}
