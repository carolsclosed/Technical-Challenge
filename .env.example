NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only scripts/email invitations; never public
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server-only Nodemailer configuration. Gmail requires its account address and
# a 16-character App Password. Never use NEXT_PUBLIC_ for these values.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=mesa.
# Supabase Authentication > Hooks > Send Email signing secret.
# Copy the same value to the app and the Supabase hook configuration.
SEND_EMAIL_HOOK_SECRET=
# Development only: use these three values together to deliver into Mailpit:
# SMTP_HOST=127.0.0.1, SMTP_PORT=54325, SMTP_ALLOW_LOCAL=true.
# Leave this false when the Gmail settings above are configured.
SMTP_ALLOW_LOCAL=false
